import ../../../editor/control.dl
import ../../../editor/source_draft_colors.dl

document example:
    editor "Source" containing "one\n🦊 two" using no UI appearance

set instance to an instance of example
set window to the address of instance
set node to the control labeled "Source" in window
color UI text "one\n🦊 two" in node in window
add UI text color (UI ink 1 2 3) from 0 to 3 in node in window
add UI text color (UI ink 4 5 6) from 4 to 8 in node in window
add UI text color (UI ink 7 8 9) from 9 to 12 in node in window
set UI text of node in window to "one +\n🦊 two"
retain UI source draft colors in node in window
set value to the UI value for node in window
require condition (value's colored text = value's text) reporting "Typing hid the preceding color snapshot"
require condition ((value's colors' next's start = 6) and (value's last color's end = 14)) reporting "Typing did not shift following line colors"
set UI text of node in window to "one +\ncat two"
retain UI source draft colors in node in window
require condition ((value's colors' next = value's last color) and (value's last color's start = 10)) reporting "Editing a token damaged colors outside its range"
require condition (value's last color's next = @intrinsic("construct", a pointer to UI text color span)) reporting "Removing an edited color left a dangling span"
set UI text of node in window to ""
retain UI source draft colors in node in window
require condition ((value's colors = @intrinsic("construct", a pointer to UI text color span)) and (value's last color = @intrinsic("construct", a pointer to UI text color span))) reporting "Replacing the source retained unrelated colors"
set UI text of node in window to "uncolored"
retain UI source draft colors in node in window
require condition ((value's colored text = value's text) and (value's colors = @intrinsic("construct", a pointer to UI text color span))) reporting "An uncolored draft gained unrelated spans"
close window
print line "Draft edits preserve and shift unaffected colors without retaining edited spans."
