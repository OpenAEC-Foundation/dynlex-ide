# Resolve paused source through the same provider as definition navigation.
import debug_model.dl
import project.dl
import ../editor/source_navigation.dl

to [show Studio debug location] {a pointer to JSON value:frame} [in] {a pointer to website state:state}:
    clear pending Studio debug source in state
    set editor to the UI source editor labeled "IDE source" in (state's language)
    set project to editor's document's project
    set uri to the JSON text named "uri" in frame
    set document to the UI source document at uri in project
    if document = (0 as a pointer to UI source document):
        set session to the address of (state's studio debug)
        set parameters to an LSP text document identifier for uri
        set session's source query to request UI source feature "dynlex/readDocument" with parameters parameters in (editor's document)
        free parameters
        set session's source generation to session's source query's generation
        # The paused snapshot owns this frame until the request is cancelled.
        set session's source frame to frame
        animate UI view (state's view)
        return nothing
    set span to the UI source range of frame in document
    require condition (span's visible) reporting "The paused program refers to a hidden source range"
    show UI source document document in editor in (state's view)
    set editor's current's anchor and editor's current's caret to span's start
    restore UI source location (editor's current) in editor in (state's view)
    set state's view's reveal caret to true
    reveal focused UI content in (state's view)
    set value to the UI text state for document in editor in (state's view's instance)
    mark UI text (document's source) in layer "debug execution" at priority 20 in value
    add UI text mark (UI ink 210 170 70) from (span's start) to (span's end) with opacity 110 in layer "debug execution" in value
    display Studio files in state
    animate UI view (state's view)

to [update Studio debug source in] {a pointer to website state:state}:
    set session to the address of (state's studio debug)
    set query to session's source query
    if query = (0 as a pointer to UI source query):
        return nothing
    set editor to the UI source editor labeled "IDE source" in (state's language)
    if (query's generation != session's source generation) or ((query is current for UI source document (editor's document)) = false):
        clear pending Studio debug source in state
        return nothing
    if query's ready = false:
        return nothing
    require condition (query's result's kind = the JSON text kind) reporting "The paused source is unavailable from the language service"
    set frame to session's source frame
    set uri to the JSON text named "uri" in frame
    set project to editor's document's project
    set document to the UI source document at uri in project
    if document = (0 as a pointer to UI source document):
        set name to the UI source filename in uri
        set writable to false
        loop index from 0 to (project's files' length):
            set file to the item at index in (project's files' members)
            if (the project URI for (file's name) under (state's language's client's root)) = uri:
                set name to file's name
                set writable to true
        set document to a UI source document named name at uri containing (query's result's text) in project
        set document's writable to writable
    show Studio debug location frame in state
