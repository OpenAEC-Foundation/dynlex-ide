import ../../../documentation.dl
import types.dl
import appearance.dl

website page IDE page at "/ide/index.html" titled "DynLex Studio" described "Write, compile and run DynLex programs in the browser.":
    region "Studio" using IDE workspace appearance:
        paragraph "DYNLEX / STUDIO" using IDE signal appearance
        paragraph "Working ideas." using title appearance
        region "Studio tools" using IDE tools appearance:
            link "Run program ▶" to "action:run-ide" using primary link appearance
            link "Stop program ■" to "action:stop-ide" using IDE link appearance
            link "Save source ↓" to "action:save-source" using IDE link appearance
            link "Switch to light" to "action:toggle-ide-theme" using IDE link appearance
        view group "Studio appearance notice" using no UI appearance:
            paragraph "Studio appearance error" containing "An error occurred. Check the log." using IDE signal appearance
        region "Studio workspace" using columns appearance:
            tab group "IDE modes" using IDE tabs appearance:
                tab "Program":
                    source pane "IDE source" containing "import lib/std.dl\n\nprint line \"Hello from DynLex.\"" using IDE code appearance
                tab "Shader":
                    source pane "Shader source" containing the default website shader source using IDE code appearance
            region "Studio result" using IDE card appearance:
                view group "IDE result" using stack appearance:
                    region "Program result" using stack appearance:
                        paragraph "Output" using subheading appearance
                        paragraph "IDE output" containing "Run the program to see its output." using output appearance
                    region "Shader result" using stack appearance:
                        paragraph "Last successful build" using subheading appearance
                        surface "IDE shader preview" using IDE preview appearance
                        region "Preview playback" using cards appearance:
                            link "Pause preview" to "action:toggle-preview" using IDE link appearance
                            link "Reset time ↺" to "action:reset-preview" using IDE link appearance
                paragraph "IDE status" containing "Ready." using IDE signal appearance
                region "Studio details" using IDE details appearance:
                    region "Studio project" using stack appearance:
                        paragraph "Files" using subheading appearance
                        read only text surface "Project files" containing "" using IDE file tree appearance
                    region "Studio problems" using stack appearance:
                        paragraph "Problems" using subheading appearance
                        paragraph "IDE diagnostics" containing "The language service checks your code as you type." using output appearance
                        paragraph "IDE analysis" containing "Language service waiting." using IDE signal appearance
                region "Project file management" using stack appearance:
                    paragraph "File path label" containing "File path" using IDE signal appearance
                    text field "File path" containing "" using IDE link appearance
                    region "File actions" using IDE file actions appearance:
                        link "New file" to "action:new-studio-file" using IDE link appearance
                        link "Rename file" to "action:rename-studio-file" using IDE link appearance
                        link "Delete file" to "action:delete-studio-file" using IDE link appearance
                    paragraph "File status" containing "" using IDE signal appearance
                region "Project libraries" using stack appearance:
                    paragraph "Libraries" using subheading appearance
                    link "＋ Add Library" to "action:add-library" using IDE link appearance
                    view group "Library picker" using no UI appearance:
                        text field "Search libraries" containing "" using IDE link appearance
                        choice field "Available library" choosing "":
                        paragraph "Library description" containing "Choose Add Library to browse libraries." using IDE signal appearance
                        text field "Import library as" containing "ui" using IDE link appearance
                        paragraph "Library import name help" containing "Use lowercase letters, digits, and hyphens." using IDE signal appearance
                        link "Add selected library" to "action:install-library" using IDE link appearance
                        text field "Library source URL" containing "" using IDE link appearance
                        link "Add from URL" to "action:library-url" using IDE link appearance
                        link "Browse local folder…" to "action:library-folder" using IDE link appearance
                        link "Close library picker" to "action:close-library-picker" using IDE link appearance
                    choice field "Installed library" choosing "":
                    region "Library actions" using IDE file actions appearance:
                        link "Update library" to "action:update-library" using IDE link appearance
                        link "Remove library" to "action:remove-library" using IDE link appearance
                        link "Library documentation" to "action:library-documentation" using IDE link appearance
                    paragraph "Library status" containing "" using IDE signal appearance
                link "Read the language reference →" to "/wiki/index.html" using IDE link appearance
