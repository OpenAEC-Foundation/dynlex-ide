import configuration.dl
import ../editor/source_annotations.dl
import ../../dynlex-ui/ui/text_marks.dl

to [clear Studio debug marks in] {a pointer to website state:state}:
    set editor to the UI source editor labeled "IDE source" in (state's language)
    set buffer to editor's buffers
    loop while buffer != (0 as a pointer to UI source buffer):
        set value to the UI text state for (buffer's document) in editor in (state's view's instance)
        ignore clear UI text marks in layer "debug execution" in value
        set buffer to buffer's next

to [clear the Studio pause in] {a pointer to website state:state}:
    set session to the address of (state's studio debug)
    set state's language's tools' runtime values to 0 as a pointer to JSON value
    dismiss UI source hover (the address of (state's language's tools' hover)) in (state's view)
    clear Studio debug marks in state
    if session's query != 0:
        ignore cancel website request (session's query) in state
        set session's query to 0
    set session's paused to false
    set session's pause to 0
    free session's snapshot
    free session's children
    free session's expanded
    free session's rows
    set session's snapshot to a new JSON value of kind the JSON array kind
    set session's rows to a new JSON value of kind the JSON array kind
    set session's children to a new JSON value of kind the JSON object kind
    set session's expanded to a new JSON value of kind the JSON object kind
    set the text of "Debug stack" in (state's view's instance) to ""
    set the text of "Debug variables" in (state's view's instance) to ""

to [end Studio debugging in] {a pointer to website state:state}:
    if state's studio debug's active:
        clear the Studio pause in state
        set pending to state's requests
        loop while pending != (0 as a pointer to website request):
            set next to pending's next
            if (pending's purpose = 26) and (pending's index = state's studio debug's invocation):
                ignore cancel website request (pending's id) in state
            set pending to next
        set state's studio debug's active to false
        set state's studio debug's invocation to 0

to get [the Studio debug breakpoint key of] {a pointer to JSON value:point}:
    set uri to the JSON text named "uri" in point
    set line to (the JSON number named "line" in point) as an integer
    return formatted "{uri}:{line}"

to [display Studio debug controls in] {a pointer to website state:state}:
    set session to the address of (state's studio debug)
    set instance to state's view's instance
    set enabled to (the website editor uses shaders in state) = false
    set active to session's active
    set paused to active and (session's paused)
    set the "Debug program" control in instance enabled (enabled and (active = false))
    set the "Continue debugging" control in instance enabled paused
    set the "Pause debugging" control in instance enabled (active and ((paused = false) and ((state's programs + 2)'s phase = 2)))
    for each label in ["Step over", "Step into", "Step out"]:
        set the label control in instance enabled paused
    set the "Toggle breakpoint" control in instance enabled (enabled and ((the website source editor in state)'s document's writable))
    set the "Clear breakpoints" control in instance enabled enabled
    set target to "Continue debugging" if active, else "Debug program"
    set scope to the control labeled "IDE source" in instance
    bind UI key 294 with modifiers 0 from scope in instance activating (the control labeled target in instance)
    for each binding in [
        @intrinsic("construct", UI key binding, 298, 0, "Toggle breakpoint"),
        @intrinsic("construct", UI key binding, 299, 0, "Step over"),
        @intrinsic("construct", UI key binding, 300, 0, "Step into"),
        @intrinsic("construct", UI key binding, 300, 1, "Step out")
    ]:
        bind UI key (binding's key) with modifiers (binding's modifiers) from scope in instance activating (the control labeled (binding's label) in instance)

class:
    patterns:
        UI key binding
    members:
        key as an integer
        modifiers as an integer
        label as a C string

to [display Studio breakpoints in] {a pointer to website state:state}:
    set text to the string form of ""
    set points to state's studio debug's breakpoints
    set index to 0
    loop while index < points's length:
        set point to the JSON value at index index in points
        set uri to the JSON text named "uri" in point
        set line to ((the JSON number named "line" in point) as an integer) + 1
        set text to formatted "{text}{uri}:{line}\n"
        increment index
    set the text of "Debug breakpoints" in (state's view's instance) to text
    refresh Studio breakpoint marks in state

to [refresh Studio breakpoint marks in] {a pointer to website state:state}:
    set editor to the UI source editor labeled "IDE source" in (state's language)
    set buffer to editor's buffers
    loop while buffer != (0 as a pointer to UI source buffer):
        set document to buffer's document
        set value to the UI text state for document in editor in (state's view's instance)
        mark UI text (document's source) in layer "debug breakpoints" at priority 8 in value
        set source to document's prefix + document's source
        scan lines in source and set scanned to it
        require condition (scanned succeeded) reporting "Breakpoint source is not valid UTF-8"
        set lines to the line index of scanned
        set index to 0
        loop while index < state's studio debug's breakpoints' length:
            set point to the JSON value at index index in (state's studio debug's breakpoints)
            if (the JSON text named "uri" in point) = document's uri:
                set line to (the JSON number named "line" in point) as an integer
                set first to the start of line line in lines
                set last to the content end of line line in lines
                if (first succeeded) and (last succeeded):
                    set span to the UI source span from (first's position) to (last's position) in document
                    if (span's visible) and (span's end > span's start):
                        add UI text mark (UI ink 200 75 90) from (span's start) to (span's end) with opacity 70 in layer "debug breakpoints" in value
            increment index
        free lines
        set buffer to buffer's next

to [append Studio debug variable] {a pointer to JSON value:variable} [at depth] {integer:depth} [to] {a pointer to string:text} [in] {a pointer to website state:state}:
    set session to the address of (state's studio debug)
    set reference to (the JSON number named "reference" in variable) as an integer
    set key to formatted "{reference}"
    set expandable to (the JSON number named "children" in variable) > 0.0
    set expanded to session's expanded has JSON member named key
    set prefix to the string form of ""
    loop level from 0 to depth:
        set prefix to prefix + "  "
    set marker to "- " if expanded, else ("+ " if expandable, else "  ")
    set name to the JSON text named "name" in variable
    set kind to the JSON text named "type" in variable
    set value to the JSON text named "value" in variable
    set the value at text to formatted "{the value at text}{prefix}{marker}{name}: {kind} = {value}\n"
    add (a JSON object containing [JSON number "reference" is reference, JSON number "start" is 0]) to the JSON array (session's rows)
    if expanded and (session's children has JSON member named key):
        set children to the JSON member named key in (session's children)
        set index to 0
        loop while index < children's length:
            append Studio debug variable (the JSON value at index index in children) at depth (depth + 1) to text in state
            increment index
        if (children's length as a floating-point number) < (the JSON number named "children" in variable):
            set the value at text to formatted "{the value at text}{prefix}  Load more…\n"
            add (a JSON object containing [JSON number "reference" is reference, JSON number "start" is (children's length)]) to the JSON array (session's rows)

to [display the Studio debug frame in] {a pointer to website state:state}:
    set session to the address of (state's studio debug)
    set frames to session's snapshot
    set stack to the string form of ""
    set index to 0
    loop while index < frames's length:
        set frame to the JSON value at index index in frames
        set prefix to "* " if index = session's selected frame, else "  "
        set name to the JSON text named "name" in frame
        set line to ((the JSON number named "line" in (the JSON member named "start" in (the JSON member named "range" in frame))) as an integer) + 1
        set stack to formatted "{stack}{prefix}{name} · line {line}\n"
        increment index
    set frame to the JSON value at index (session's selected frame) in frames
    set variables to the JSON member named "variables" in frame
    set state's language's tools' runtime values to variables
    dismiss UI source hover (the address of (state's language's tools' hover)) in (state's view)
    free session's rows
    set session's rows to a new JSON value of kind the JSON array kind
    set text to the string form of ""
    set index to 0
    loop while index < variables's length:
        append Studio debug variable (the JSON value at index index in variables) at depth 0 to (the address of text) in state
        increment index
    set the text of "Debug stack" in (state's view's instance) to stack
    set the text of "Debug variables" in (state's view's instance) to text
