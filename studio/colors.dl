import ../../../patterns.dl

palette website dark colors:
    color "Studio background" is UI ink 20 23 30
    color "Studio surface" is UI ink 27 31 40
    color "Studio raised" is UI ink 35 40 51
    color "Studio border" is UI ink 49 56 70
    color "Studio text" is UI ink 244 244 245
    color "Studio muted" is UI ink 161 161 170
    color "Studio accent" is UI ink 245 158 11
    color "Studio on accent" is UI ink 24 24 27
    color "Studio danger" is UI ink 244 139 148
    color "Editor background" is UI ink 22 26 34
    color "Editor text" is UI ink 250 250 249

palette website light colors:
    color "Studio background" is UI ink 242 244 248
    color "Studio surface" is UI ink 255 255 255
    color "Studio raised" is UI ink 245 247 250
    color "Studio border" is UI ink 214 219 228
    color "Studio text" is UI ink 54 54 62
    color "Studio muted" is UI ink 98 98 109
    color "Studio accent" is UI ink 146 64 14
    color "Studio on accent" is UI ink 255 255 255
    color "Studio danger" is UI ink 171 39 55
    color "Editor background" is UI ink 255 255 255
    color "Editor text" is UI ink 54 54 62

function [the website colors for] {boolean:bright}:
    globals:
        website dark colors
        website light colors
    execute:
        return website light colors if bright, else website dark colors
