import programs.dl

to get follow Studio action {string:destination} in {a pointer to website state:state}:
    if change Studio file using destination in state:
        save changed Studio projects in state
        return true
    if destination = "action:toggle-ide-theme":
        toggle website editor theme in state
        return true
    if destination = "action:toggle-preview":
        toggle the website shader preview in state
        return true
    if destination = "action:reset-preview":
        reset the website shader preview in state
        return true
    if destination = "action:save-source":
        set source to the website source text in state
        set name to the website source filename in state
        set selected to (the website source editor in state)'s document
        if selected's writable:
            set source to selected's source
            set leaf to the filename of (selected's filename) using the POSIX path style
            set name to leaf's value
        request "download" containing (a JSON object containing [JSON text "name" is name, JSON text "type" is "text/plain;charset=utf-8", JSON text "content" is source]) for purpose 0 indexed 0 in state
        return true
    return false

to select website editor mode {integer:mode} in {a pointer to website state:state}:
    stop website program 2 in state
    set instance to state's view's instance
    set the value of "IDE modes" in instance to mode
    set the value of "IDE result" in instance to mode
    set caption to "Recompile shader ↻" if (mode = 1), else "Run program ▶"
    set the text of "Run program ▶" in instance to caption
    set the text of "IDE status" in instance to "Ready."
    set the text of "IDE diagnostics" in instance to "Checking source…"
    set the text of "IDE analysis" in instance to "Analyzing…"

to notice website editor mode {a pointer to UI instance:instance}:
    set state to the website state in instance
    set selected to the value of "IDE modes" in instance
    select website editor mode selected in state
    if selected = 1:
        if state's shader editor's preview's resource = (0 as a pointer):
            run website program 2 in state
        else:
            toggle the website shader preview in state

to bind Studio controls in {a pointer to UI instance:instance}:
    bind (the control labeled "IDE source" in instance) in instance to (the function named "notice website source edit $") for event 0
    bind (the control labeled "Shader source" in instance) in instance to (the function named "notice website source edit $") for event 0
    bind (the control labeled "IDE modes" in instance) in instance to (the function named "notice website editor mode $") for event 0
    bind (the control labeled "IDE shader preview" in instance) in instance to (the function named "paint the website shader preview $") for event 1
