import file_prompt.dl
import ../../dynlex-ui/ui/key_bindings.dl

class:
    patterns:
        Studio command alias
    members:
        label as a C string
        target as a C string

the Studio command aliases means: [
    @intrinsic("construct", Studio command alias, "Toolbar Run", "Run program"),
    @intrinsic("construct", Studio command alias, "Toolbar Debug", "Debug program"),
    @intrinsic("construct", Studio command alias, "Toolbar Stop", "Stop program"),
    @intrinsic("construct", Studio command alias, "Toolbar Save", "Save source"),
    @intrinsic("construct", Studio command alias, "Toolbar Continue", "Continue debugging"),
    @intrinsic("construct", Studio command alias, "Toolbar Pause", "Pause debugging"),
    @intrinsic("construct", Studio command alias, "Toolbar Stop debugging", "Stop program"),
    @intrinsic("construct", Studio command alias, "Toolbar Step over", "Step over"),
    @intrinsic("construct", Studio command alias, "Toolbar Step into", "Step into"),
    @intrinsic("construct", Studio command alias, "Toolbar Step out", "Step out"),
    @intrinsic("construct", Studio command alias, "Toolbar Save debugging", "Save source"),
    @intrinsic("construct", Studio command alias, "Explorer New", "Create file command"),
    @intrinsic("construct", Studio command alias, "Explorer Rename", "Rename file command"),
    @intrinsic("construct", Studio command alias, "Explorer Delete", "Delete file command"),
    @intrinsic("construct", Studio command alias, "Console Copy", "Copy output"),
    @intrinsic("construct", Studio command alias, "Console Clear", "Clear output")
]

to [present Studio chrome in] {a pointer to website state:state}:
    if state's route != "/ide/index.html":
        return nothing
    set instance to state's view's instance
    set program to state's programs + 2
    set session to the address of (state's studio debug)
    set document to (the website source editor in state)'s document
    set the value of "Studio run toolbar" in instance to (1 if session's active, else 0)
    set the "Stop program" control in instance enabled ((program's phase != 0) or (state's shader editor's source request != 0))
    set output to ((the website editor uses shaders in state) = false) and (program's output's length > 0)
    set the "Copy output" control in instance enabled output
    set the "Clear output" control in instance enabled output
    set the "Rename file command" control in instance enabled (document's writable)
    set the "Delete file command" control in instance enabled ((document's writable) and (document != document's project's entry))
    set the text of "Toolbar Run" in instance to ("Build shader" if the website editor uses shaders in state, else "Run")
    set hint to "Start debugging to inspect your program."
    if session's active:
        set hint to "Paused" if session's paused, else ("Preparing session…" if program's phase = 1, else "Running")
    set the text of "Debug inspector status" in instance to hint
    for each alias in (the Studio command aliases):
        set target to the control labeled (alias's target) in instance
        set the (alias's label) control in instance enabled (the UI element target is enabled in instance)

to [initialize Studio chrome in] {a pointer to website state:state}:
    set instance to state's view's instance
    set the value of "Studio file prompt" in instance to -1
    set the value of "Studio inspector" in instance to 0
    for each modifiers in [2, 8]:
        bind UI key 83 with modifiers modifiers from (the control labeled "Studio" in instance) in instance activating (the control labeled "Save source" in instance)

to get [follow Studio chrome action] {string:destination} [in] {a pointer to website state:state}:
    set instance to state's view's instance
    set targets to ["action:studio-files", "action:studio-debugger", "action:studio-problems", "action:studio-shortcuts"]
    loop index from 0 to the length of targets:
        if destination = (the item at index in targets):
            set the value of "Studio inspector" in instance to index
            animate UI view (state's view)
            return true
    set prompts to ["action:prompt-new-studio-file", "action:prompt-rename-studio-file", "action:prompt-delete-studio-file"]
    loop index from 0 to the length of prompts:
        if destination = (the item at index in prompts):
            show Studio file prompt index in state
            return true
    if destination = "action:cancel-studio-file":
        cancel the Studio file prompt in state
        return true
    if destination = "action:copy-studio-output":
        set text to (state's programs + 2)'s output
        @intrinsic("call pointer", state's view's driver's copy, nothing, state's view, the data of text, text's length)
        return true
    if destination = "action:clear-studio-output":
        set (state's programs + 2)'s output to ""
        set the text of "IDE output" in instance to ""
        animate UI view (state's view)
        return true
    return false
