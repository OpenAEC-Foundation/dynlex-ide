import ../../../documentation.dl
import ../../dynlex-ui/ui/document_commands.dl
import types.dl
import appearance.dl

website page IDE page at "/ide/index.html" titled "DynLex Studio" described "Write, compile and run DynLex programs in the browser.":
    region "Studio" using IDE workspace appearance:
        region "Studio app bar" using IDE app bar appearance:
            command link "Studio home" titled "DynLex Studio" with icon "" to "/index.html" using IDE identity appearance
            region "Studio menus" using IDE menus appearance:
                command menu "File menu" titled "File" using IDE menu appearance:
                    command link "Create file command" titled "New file" with icon "new-file" to "action:prompt-new-studio-file" using IDE command appearance
                    command link "Rename file command" titled "Rename file" with icon "rename" to "action:prompt-rename-studio-file" using IDE command appearance
                    command link "Delete file command" titled "Delete file" with icon "delete" to "action:prompt-delete-studio-file" using IDE command appearance
                    command link "Save source" titled "Save source" with icon "save" to "action:save-source" using IDE command appearance
                    command link "Add library command" titled "Add library" with icon "new-file" to "action:add-library" using IDE command appearance
                command menu "Run menu" titled "Run" using IDE menu appearance:
                    command link "Run program" titled "Run program" with icon "play" to "action:run-ide" using IDE command appearance
                    command link "Stop program" titled "Stop program" with icon "stop" to "action:stop-ide" using IDE command appearance
                    command link "Copy output" titled "Copy output" with icon "copy" to "action:copy-studio-output" using IDE command appearance
                    command link "Clear output" titled "Clear output" with icon "clear" to "action:clear-studio-output" using IDE command appearance
                command menu "Debug menu" titled "Debug" using IDE menu appearance:
                    command link "Debug program" titled "Start debugging" with icon "debug" to "action:debug-ide" using IDE command appearance
                    command link "Continue debugging" titled "Continue" with icon "play" to "action:debug-continue" using IDE command appearance
                    command link "Pause debugging" titled "Pause" with icon "pause" to "action:debug-pause" using IDE command appearance
                    command link "Step over" titled "Step over" with icon "step-over" to "action:debug-over" using IDE command appearance
                    command link "Step into" titled "Step into" with icon "step-into" to "action:debug-into" using IDE command appearance
                    command link "Step out" titled "Step out" with icon "step-out" to "action:debug-out" using IDE command appearance
                    command link "Toggle breakpoint" titled "Toggle breakpoint" with icon "breakpoint" to "action:breakpoint-ide" using IDE command appearance
                    command link "Clear breakpoints" titled "Clear breakpoints" with icon "clear-breakpoints" to "action:clear-breakpoints-ide" using IDE command appearance
                command menu "View menu" titled "View" using IDE menu appearance:
                    command link "Show files" titled "Files" with icon "folder" to "action:studio-files" using IDE command appearance
                    command link "Show debugger" titled "Debugger" with icon "debug" to "action:studio-debugger" using IDE command appearance
                    command link "Show problems" titled "Problems" with icon "fix" to "action:studio-problems" using IDE command appearance
                    command link "Toggle theme" titled "Light theme" with icon "colors" to "action:toggle-ide-theme" using IDE command appearance
                command menu "Help menu" titled "Help" using IDE menu appearance:
                    command link "Keyboard shortcuts" titled "Keyboard shortcuts" with icon "keys" to "action:studio-shortcuts" using IDE command appearance
                    command link "Language reference" titled "Language reference" with icon "docs" to "/wiki/index.html" using IDE command appearance
            view group "Studio run toolbar" using IDE toolbar slot appearance:
                region "Studio launch commands" using IDE toolbar appearance:
                    command link "Toolbar Run" titled "Run" with icon "play" to "action:run-ide" using IDE primary command appearance
                    command link "Toolbar Debug" titled "Debug" with icon "debug" to "action:debug-ide" using IDE secondary command appearance
                    icon link "Toolbar Stop" titled "Stop (Shift+F5)" with icon "stop" to "action:stop-ide" using IDE stop command appearance
                    icon link "Toolbar Save" titled "Save source (Ctrl+S)" with icon "save" to "action:save-source" using IDE command appearance
                region "Studio session commands" using IDE toolbar appearance:
                    command link "Toolbar Continue" titled "Continue" with icon "play" to "action:debug-continue" using IDE primary command appearance
                    icon link "Toolbar Pause" titled "Pause" with icon "pause" to "action:debug-pause" using IDE command appearance
                    icon link "Toolbar Stop debugging" titled "Stop (Shift+F5)" with icon "stop" to "action:stop-ide" using IDE stop command appearance
                    icon link "Toolbar Step over" titled "Step over (F10)" with icon "step-over" to "action:debug-over" using IDE command appearance
                    icon link "Toolbar Step into" titled "Step into (F11)" with icon "step-into" to "action:debug-into" using IDE command appearance
                    icon link "Toolbar Step out" titled "Step out (Shift+F11)" with icon "step-out" to "action:debug-out" using IDE command appearance
                    icon link "Toolbar Save debugging" titled "Save source (Ctrl+S)" with icon "save" to "action:save-source" using IDE command appearance
        view group "Studio appearance notice" using no UI appearance:
            paragraph "Studio appearance error" containing "An error occurred. Check the log." using IDE signal appearance
        region "Studio workspace" using IDE workspace columns appearance:
            region "Studio editor column" using IDE editor column appearance:
                tab group "IDE modes" using IDE tabs appearance:
                    tab "Program":
                        source pane "IDE source" containing "import lib/std.dl\n\nprint line \"Hello from DynLex.\"" using IDE code appearance
                    tab "Shader":
                        source pane "Shader source" containing the default website shader source using IDE code appearance
                view group "IDE result" using no UI appearance:
                    region "Program result" using IDE console appearance:
                        region "Console header" using IDE console header appearance:
                            paragraph "Output" using IDE console title appearance
                            icon link "Console Copy" titled "Copy output" with icon "copy" to "action:copy-studio-output" using IDE command appearance
                            icon link "Console Clear" titled "Clear output" with icon "clear" to "action:clear-studio-output" using IDE command appearance
                        read only text surface "IDE output" containing "Program output appears here." using IDE console output appearance
                    region "Shader result" using IDE console appearance:
                        region "Preview playback" using IDE toolbar appearance:
                            paragraph "Shader preview" using IDE console title appearance
                            command link "Pause preview" titled "Pause preview" with icon "pause" to "action:toggle-preview" using IDE command appearance
                            command link "Reset time" titled "Reset time" with icon "reset" to "action:reset-preview" using IDE command appearance
                        surface "IDE shader preview" using IDE preview appearance
            region "Studio inspector panel" using IDE inspector appearance:
                tab group "Studio inspector" using IDE tabs appearance:
                    tab "Files":
                        region "Studio project" using IDE panel content appearance:
                            region "Explorer commands" using IDE toolbar appearance:
                                paragraph "Workspace" using IDE console title appearance
                                icon link "Explorer New" titled "New file" with icon "new-file" to "action:prompt-new-studio-file" using IDE command appearance
                                icon link "Explorer Rename" titled "Rename file" with icon "rename" to "action:prompt-rename-studio-file" using IDE command appearance
                                icon link "Explorer Delete" titled "Delete file" with icon "delete" to "action:prompt-delete-studio-file" using IDE stop command appearance
                            read only text surface "Project files" containing "" using IDE file tree appearance
                            view group "Studio file prompt" using no UI appearance:
                                region "File operation" using IDE panel content appearance:
                                    paragraph "File prompt title" containing "New file" using IDE panel heading appearance
                                    view group "Studio filename entry" using no UI appearance:
                                        text field "File path" containing "" using IDE field appearance
                                    view group "Studio file operation" using no UI appearance:
                                        command link "New file" titled "Create file" with icon "new-file" to "action:new-studio-file" using IDE primary command appearance
                                        command link "Rename file" titled "Rename file" with icon "rename" to "action:rename-studio-file" using IDE primary command appearance
                                        command link "Delete file" titled "Delete file" with icon "delete" to "action:delete-studio-file" using IDE stop command appearance
                                    command link "Cancel file operation" titled "Cancel" with icon "" to "action:cancel-studio-file" using IDE command appearance
                            paragraph "File status" containing "" using IDE signal appearance
                            region "Project libraries" using IDE panel content appearance:
                                paragraph "Libraries" using IDE panel heading appearance
                                command link "＋ Add Library" titled "Add library" with icon "new-file" to "action:add-library" using IDE command appearance
                                view group "Library picker" using no UI appearance:
                                    region "Library picker fields" using IDE panel content appearance:
                                        paragraph "Search libraries label" containing "Search libraries" using IDE signal appearance
                                        text field "Search libraries" containing "" using IDE field appearance
                                        paragraph "Available libraries label" containing "Available libraries" using IDE signal appearance
                                        choice field "Available library" choosing "":
                                        paragraph "Library description" containing "Choose Add Library to browse libraries." using IDE signal appearance
                                        paragraph "Library import name label" containing "Import name" using IDE signal appearance
                                        text field "Import library as" containing "ui" using IDE field appearance
                                        paragraph "Library import name help" containing "Use lowercase letters, digits, and hyphens." using IDE signal appearance
                                        command link "Add selected library" titled "Add selected library" with icon "new-file" to "action:install-library" using IDE command appearance
                                        paragraph "Library source URL label" containing "Repository or SDK archive URL" using IDE signal appearance
                                        text field "Library source URL" containing "" using IDE field appearance
                                        command link "Add from URL" titled "Add from URL" with icon "link" to "action:library-url" using IDE command appearance
                                        command link "Browse local folder…" titled "Browse local folder…" with icon "folder" to "action:library-folder" using IDE command appearance
                                        command link "Close library picker" titled "Close library picker" with icon "clear" to "action:close-library-picker" using IDE command appearance
                                view group "Installed project libraries" using no UI appearance:
                                    region "Installed library controls" using IDE panel content appearance:
                                        paragraph "Installed libraries label" containing "Installed libraries" using IDE signal appearance
                                        choice field "Installed library" choosing "":
                                        command menu "Library actions" titled "Actions" using IDE secondary command appearance:
                                            command link "Update library" titled "Update library" with icon "reset" to "action:update-library" using IDE command appearance
                                            command link "Remove library" titled "Remove library" with icon "delete" to "action:remove-library" using IDE command appearance
                                            command link "Library documentation" titled "Library documentation" with icon "docs" to "action:library-documentation" using IDE command appearance
                                paragraph "Library status" containing "" using IDE signal appearance
                    tab "Debug":
                        region "Studio debugger" using IDE panel content appearance:
                            paragraph "Debug inspector status" containing "Start debugging to inspect your program." using IDE signal appearance
                            paragraph "Call stack" using IDE panel heading appearance
                            read only text surface "Debug stack" containing "" using IDE debug data appearance
                            paragraph "Variables" using IDE panel heading appearance
                            read only text surface "Debug variables" containing "" using IDE variables appearance
                            paragraph "Breakpoints" using IDE panel heading appearance
                            read only text surface "Debug breakpoints" containing "" using IDE breakpoints appearance
                    tab "Problems":
                        region "Studio problems" using IDE panel content appearance:
                            read only text surface "IDE diagnostics" containing "The language service checks your code as you type." using IDE problems appearance
                    tab "Keys":
                        region "Studio keyboard help" using IDE panel content appearance:
                            paragraph "Keyboard shortcuts title" containing "Keyboard shortcuts" using IDE panel heading appearance
                            paragraph "Run shortcuts" containing "F5  Debug / continue\nShift+F5  Stop\nF9  Toggle breakpoint\nF10  Step over\nF11  Step into\nShift+F11  Step out" using IDE signal appearance
                            paragraph "Editor shortcuts" containing "Ctrl+S  Save source\nCtrl+F  Find\nCtrl+Space  Complete\nCtrl+.  Quick fix\nShift+F10  Context menu\nF12  Definition\nAlt+Left  Go back\nCtrl+Shift+O  Outline" using IDE signal appearance
        region "Studio status bar" using IDE status bar appearance:
            paragraph "IDE status" containing "Ready." using IDE signal appearance
            paragraph "IDE analysis" containing "Language service waiting." using IDE signal appearance
