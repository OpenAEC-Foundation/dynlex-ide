import source_changes.dl

to get [UI source text] {string:inserted} [can trigger completion]:
    if inserted's length = 0:
        return false
    set character to the UTF8 character at 0 in inserted
    return (character's valid and (character's next = inserted's length)) and ((character's code >= 32) and (character's code != 127))

# Compare Unicode boundaries so browser replacement edits and native character
# input follow one policy. Bulk paste, deletion and line breaks do not open it.
to get [the UI source insertion from] {string:before} [to] {string:after}:
    return (the UI source replacement from before to after)'s text

to get [UI source text] {string:inserted} [completes a composition]:
    if inserted's length = 0:
        return false
    set index to 0
    loop while index < inserted's length:
        set character to the UTF8 character at index in inserted
        if ((character's valid = false) or (character's code < 32)) or (character's code = 127):
            return false
        set index to character's next
    return true
